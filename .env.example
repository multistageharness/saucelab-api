# Copy to .env (same directory as package.json) and fill in.
# Every account-, integration- and deployment-specific value lives here (or in the process
# environment); the code hardcodes none of them. Process environment values take precedence.
# Easiest path: fill in CLIENT_ID + CLIENT_SECRET, then run `npm run auth` to populate the rest.

# OAuth integration registered in the Mural Developer Portal (https://app.mural.co/)
MURAL_CLIENT_ID=
MURAL_CLIENT_SECRET=

# Must match a redirect URI registered on the integration. `npm run auth` listens here.
MURAL_REDIRECT_URI=http://localhost:50000/callback

# Tokens. `npm run auth` stores these; you can also paste an access token by hand.
# Scopes needed: murals:read murals:write workspaces:read rooms:read rooms:write
# On macOS leave them empty: they are read from (and written back to) the login keychain.
MURAL_ACCESS_TOKEN=
MURAL_REFRESH_TOKEN=
MURAL_TOKEN_EXPIRES_AT=

# Secret store. Values set above or in the process environment always win; the store fills the
# gaps and receives refreshed tokens. On macOS the store is the login keychain, read through the
# vendored macos-keychain-env package (`make vendor` -> vendors/macos-keychain-env): service
# MURAL_KEYCHAIN_SERVICE, account = variable name. Store a value with a hidden prompt:
#   make secret KEY=MURAL_CLIENT_ID
# MURAL_SECRETS_BACKEND=auto           # auto (keychain on macOS when vendored, else env) | keychain | env
# MURAL_KEYCHAIN_SERVICE=mural-mcp     # keychain service that holds the MURAL_* items
# MURAL_KEYCHAIN_ENV_MODULE=           # path to a macos-keychain-env checkout, if not vendors/macos-keychain-env

# Optional overrides
# MURAL_SCOPES=murals:read murals:write workspaces:read rooms:read rooms:write   # must all be enabled on the app
# MURAL_AUTH_TIMEOUT_MINUTES=10
# MURAL_API_BASE_URL=https://app.mural.co/api/public/v1
# MURAL_OAUTH_AUTHORIZE_URL=https://app.mural.co/api/public/v1/authorization/oauth2/
# MURAL_OAUTH_TOKEN_URL=https://app.mural.co/api/public/v1/authorization/oauth2/token
# MURAL_OAUTH_REFRESH_URL=https://app.mural.co/api/public/v1/authorization/oauth2/refresh
# MURAL_PERSIST_TOKENS=true        # write refreshed tokens back to this file
# MURAL_REQUEST_TIMEOUT_MS=30000

# HTTP mode (node build/index.js --http) — for clients that cannot spawn a local process
# MURAL_HTTP_HOST=127.0.0.1          # keep loopback; put a tunnel/reverse proxy in front
# MURAL_HTTP_PORT=50010
# MURAL_HTTP_SECRET=                 # moves the endpoint to /<secret>/mcp (capability URL)
# MURAL_HTTP_BEARER=                 # require Authorization: Bearer <value>
