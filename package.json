{
  "name": "mcp-mural",
  "version": "0.1.0",
  "description": "MCP server (stdio / JSON-RPC 2.0) exposing Mural Public API tools, credentials loaded from a local .env file",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-mural": "build/index.js",
    "mcp-mural-auth": "build/auth.js"
  },
  "files": [
    "build",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x build/index.js build/auth.js",
    "start": "node build/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "auth": "node build/auth.js"
  },
  "keywords": [
    "mcp",
    "mural",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
